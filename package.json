{
  "name": "studio-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project studio-os-demo",
    "seed": "node scripts/seed.mjs",
    "verify:rules": "node scripts/rules-verify.mjs",
    "preview:dump": "node preview/dump-seed.mjs",
    "preview:build": "vite build --config vite.preview.config.ts && node preview/package-artifact.mjs",
    "preview:verify": "node preview/verify-artifact.mjs preview-dist/artifact.html",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "firebase": "^12.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
