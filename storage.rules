rules_version = '2';

// Tenant-scoped storage: logos and expense receipts live under the tenant's
// own prefix, gated by the same tenantId custom claim as Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    match /tenants/{tenantId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.tenantId == tenantId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
